# --- Database ---
# PostgreSQL connection string. Works with a local Postgres, or a managed
# provider like Supabase (use the "Connection pooling" URI in production).
DATABASE_URL="postgresql://user:password@localhost:5432/shutki_corner"

# --- Auth / Sessions ---
# Random 32+ character secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- SMS (OTP login) ---
# "console" logs OTP codes to the server console instead of sending real
# SMS — safe default for local development. Set to a real provider name
# once src/lib/sms.ts has an implementation for it, e.g. "bulksmsbd".
SMS_PROVIDER="console"

# --- Public site config (exposed to the browser — no secrets here) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE="+8801XXXXXXXXX"
NEXT_PUBLIC_WHATSAPP_NUMBER="8801XXXXXXXXX"

# --- Rate limiting (production) ---
# Without these, rate limiting silently falls back to an in-memory
# limiter that only applies per server process — fine for local dev,
# NOT sufficient once you run more than one instance in production.
# Create a free Redis database at https://console.upstash.com and copy
# both values from its "REST API" tab.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Review photo storage (Supabase Storage) ---
# Required for customers to attach a photo to a review. Create a bucket
# named "review-photos" (or match SUPABASE_REVIEW_PHOTOS_BUCKET below) in
# your Supabase project's Storage section.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security — it is read only
# on the server (src/lib/storage/provider.ts) and must NEVER be prefixed
# with NEXT_PUBLIC_ or referenced from client code.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_REVIEW_PHOTOS_BUCKET="review-photos"

# --- Review reminder scheduler ---
# Shared secret that an external cron trigger must send as
# "Authorization: Bearer <CRON_SECRET>" when calling
# POST /api/cron/review-reminders. Generate with: openssl rand -base64 32
# Without this set, that route refuses every request rather than running
# unauthenticated. See README.md > "Review reminders" for scheduler setup.
CRON_SECRET="replace-with-a-long-random-string"

# --- Payments (future) ---
# Left unset until an online gateway is integrated. See
# src/lib/payments/provider.ts for where these will be read.
# PAYMENT_GATEWAY_API_KEY=""
# PAYMENT_GATEWAY_SECRET=""
